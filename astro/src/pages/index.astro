---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
			</section>

			<section class="recent-posts">
				<h2>Recent Writing</h2>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="date">{new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
						</li>
					))}
				</ul>
				<p><a href="/blog">View all posts →</a></p>
			</section>

			<section class="projects">
				<h2>Projects</h2>
				<p>
					I share code and experiments on <a href="https://github.com/hobbitronics" target="_blank">GitHub</a>. 
					Current interests include:
				</p>
				<ul>
					<li>Astrophotography automation with old DSLRs</li>
					<li>Linux on vintage hardware</li>
					<li>Home automation and self-hosting</li>
					<li>DIY electronics and single-board computers</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 3em;
		padding-bottom: 2em;
		border-bottom: 1px solid var(--border);
	}
	.hero h1 {
		margin-top: 0;
		margin-bottom: 0.5rem;
	}
	.tagline {
		font-size: 1.1em;
		color: var(--text-secondary);
		margin: 0;
		line-height: 1.6;
	}
	.recent-posts ul {
		list-style: none;
		padding: 0;
	}
	.recent-posts li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 0.75em 0;
		border-bottom: 1px solid var(--border);
		gap: 1em;
	}
	.recent-posts li:last-child {
		border-bottom: none;
	}
	.recent-posts a {
		font-weight: 500;
		flex: 1;
	}
	.date {
		color: var(--text-secondary);
		font-size: 0.9em;
		white-space: nowrap;
	}
	.projects {
		margin-top: 3em;
	}
	.projects ul {
		list-style-position: inside;
		color: var(--text);
	}
	.projects li {
		margin-bottom: 0.5em;
	}
</style>
